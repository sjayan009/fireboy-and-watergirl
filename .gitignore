# Secrets. The service key bypasses RLS and the database password is a
# database password -- neither belongs in version control, ever.
.env
.env.local
.env*.local

node_modules/
.cache/
.wrangler/
supabase/.temp/
dist/
snaps/

# JPEXS intermediates: 126 MB of exports that the shipped assets are derived
# from. Regenerate with tools/export_assets.py.
extracted/assets/_raw/

# Internet Archive artifacts: the metadata and screenshots that came with the
# download. The SWF itself IS committed -- it is the only source every asset and
# every line of ported code was derived from, so a checkout without it cannot be
# rebuilt -- but none of this is.
fireboy-watergirl-the-forest-temple_*
screenshot_*.png
*_thumb.jpg
00_coverscreenshot*

# A second copy of the SWF, for the Ruffle preview.
preview/

# Python bytecode. Interpreter, version and platform derived output rather than
# reviewable source, and it was tracked -- six .pyc files that could sit stale
# beside a changed .py with nothing to say which was authoritative.
__pycache__/
*.py[cod]

CODEBASE_AUDIT.md
docs/AI_BOT_FEASIBILITY.md

# Landing-page design exploration: the board, the alternative directions, the
# motion studies and their renders are for local review only and are never
# published. The landing page itself (design/landing/index.html, shared/,
# assets/, tools/) is tracked.
design/landing/board.html
design/landing/directions/
design/landing/motion/
design/landing/renders/
# ...and the assets only those exploration pages use (regenerate with
# design/landing/tools/levels.mjs and assets.mjs).
design/landing/assets/levels/*
# ...except the four the developer site's Recovery page shows.
!design/landing/assets/levels/adventure-09.webp
!design/landing/assets/levels/puzzle-04.webp
!design/landing/assets/levels/speed-02.webp
!design/landing/assets/levels/adventure-15.webp
design/landing/assets/lever/
design/landing/assets/title.webp
