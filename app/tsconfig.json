{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@engine/*": ["../engine/dist/*"] }
  },
  "include": ["src/**/*.ts", "test/play-fixture.ts", "vite.config.ts", "scripts/**/*.mjs"]
}
