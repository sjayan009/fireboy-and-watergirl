# What the deploy does not need to upload.
#
# The build DOES need `extracted/assets` and `tools/build_assets.py`: the asset
# step reads the originals from the repo and writes the converted ones into
# app/dist. Only the things nothing reads are listed here.

extracted/assets/_raw/
*.swf
preview/
snaps/
.github/
supabase/
engine/test/
web/
